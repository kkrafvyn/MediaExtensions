DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
SESSION_SECRET=change-me
PORT=4000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Shipping (pesewas)
SHIPPING_ACCRA_PESEWAS=2500
SHIPPING_OTHER_PESEWAS=4500

# Manual payment details
MOMO_NETWORK=MTN
MOMO_NUMBER=0240000000
MOMO_NAME=Media Extensions
BANK_NAME=GCB Bank
BANK_ACCOUNT=1234567890
BANK_ACCOUNT_NAME=Media Extensions

# Pickup location
PICKUP_NAME=Media Extensions Store
PICKUP_ADDRESS=123 Independence Ave, Accra
PICKUP_LANDMARK=Near Accra Mall
PICKUP_HOURS=Mon–Sat 9:00–18:00
PICKUP_MAP_URL=https://maps.google.com/?q=Accra

# Store contact
STORE_PHONE=0240000000
STORE_WHATSAPP=233240000000
STORE_EMAIL=hello@mediaextensions.gh

# WhatsApp Cloud API (Meta) — staff agents get alerts on new orders/repairs/contacts
# https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Comma-separated agent numbers (falls back to STORE_WHATSAPP if empty)
WHATSAPP_AGENT_NUMBERS=233240000000,233501234567
# Set to 1 to also message customers via WhatsApp (requires approved templates in production)
WHATSAPP_NOTIFY_CUSTOMERS=0

# Inventory
LOW_STOCK_THRESHOLD=5

# Paystack (optional — leave empty to skip online payments)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:5173/checkout/paystack-return
# Paystack dashboard webhook URL: https://YOUR_DOMAIN/api/checkout/paystack/webhook

# Vercel build: set RUN_DB_MIGRATE=1 to run migrations during deploy
RUN_DB_MIGRATE=

# SMTP (optional — password reset falls back to notifications log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@mediaextensions.gh

# Optional first administrator. No sample products, accounts, or services are seeded.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Store administrator
