DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
SESSION_SECRET=change-me
PORT=4000
# Local: http://localhost:5173 — Production: https://www.mediaextensions.org
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Shipping (pesewas)
SHIPPING_ACCRA_PESEWAS=2500
SHIPPING_OTHER_PESEWAS=4500

# Manual payment details (PLACEHOLDERS — set real values before go-live, or use Staff → Settings)
MOMO_NETWORK=MTN
MOMO_NUMBER=
MOMO_NAME=Media Extensions
BANK_NAME=
BANK_ACCOUNT=
BANK_ACCOUNT_NAME=Media Extensions

# Pickup location (Koforidua shop — set real address or configure in Staff → Settings)
PICKUP_NAME=
PICKUP_ADDRESS=
PICKUP_LANDMARK=
PICKUP_HOURS=Mon–Sat 9:00–18:00
PICKUP_MAP_URL=

# Store contact
STORE_PHONE=
STORE_WHATSAPP=
STORE_EMAIL=hello@mediaextensions.gh

# WhatsApp Cloud API (Meta) — staff agents get alerts on new orders/repairs/contacts
# https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Comma-separated agent numbers (falls back to STORE_WHATSAPP if empty)
WHATSAPP_AGENT_NUMBERS=
# Set to 1 to also message customers via WhatsApp (requires approved templates in production)
WHATSAPP_NOTIFY_CUSTOMERS=0

# Inventory
LOW_STOCK_THRESHOLD=5

# Paystack (optional — leave empty to skip online payments)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:5173/checkout/paystack-return
# Production callback: https://www.mediaextensions.org/checkout/paystack-return
# Paystack dashboard webhook: https://www.mediaextensions.org/api/checkout/paystack/webhook

# Vercel build: set RUN_DB_MIGRATE=1 to run migrations during deploy
RUN_DB_MIGRATE=

# SMTP (optional — password reset / order emails fall back to console + notifications log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@mediaextensions.gh
# Optional public API origin used in emailed download links (defaults to CLIENT_URL)
API_PUBLIC_URL=

# File storage — local disk (dev) or S3-compatible (R2/S3) for durable Vercel uploads
STORAGE_DRIVER=local
# S3 / Cloudflare R2 (required when STORAGE_DRIVER=s3)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_PREFIX=media
# Aliases also accepted: R2_BUCKET, R2_ENDPOINT, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_PUBLIC_BASE_URL

# Optional first administrator / demo users (catalog is managed in staff console)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Store administrator
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_MANAGER_EMAIL=
SEED_MANAGER_PASSWORD=
# Demo consumer account only when ALLOW_DEMO_SEED=1 (not for production)
ALLOW_DEMO_SEED=
SEED_CONSUMER_EMAIL=
SEED_CONSUMER_PASSWORD=

# Catalog purge: PURGE_CATALOG_CONFIRM=1 npm run db:purge-catalog
