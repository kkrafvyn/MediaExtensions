{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd .. && npm install --include=dev && npm install @neondatabase/serverless@0.10.4 --workspace=server --install-strategy=nested --include=dev",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "www",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "{node_modules/@neondatabase/serverless/**,node_modules/drizzle-orm/node_modules/@neondatabase/serverless/**,dist/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/uploads/(.*)", "destination": "/api" },
    { "source": "/((?!api/|uploads/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
